# Copy to .env and fill in real secrets. Never commit the real .env file.

# --- Environment ---
# Set to "production" to enable fail-fast validation that rejects the insecure defaults below
# (placeholder JWT secret, wildcard CORS, default DB/Garage credentials) at startup.
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+asyncpg://fitfolio:fitfolio@localhost:5432/fitfolio

# --- JWT ---
# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Garage / S3-compatible object storage ---
MINIO_ENDPOINT=localhost:3900
# Optional - leave unset (don't just set to an empty string, it fails validation) unless your
# API reaches Garage on an internal/private address but clients are on the public internet.
# MINIO_PRESIGN_ENDPOINT=
# MINIO_PRESIGN_SECURE=
MINIO_ACCESS_KEY=fitfolio
MINIO_SECRET_KEY=fitfolio123
MINIO_BUCKET=fitfolio-images
MINIO_SECURE=false
# Reject uploaded images larger than this many bytes (verified server-side on confirm).
MAX_UPLOAD_SIZE_BYTES=10485760
# Must match Garage's configured `s3_region` (see garage/garage.toml).
MINIO_REGION=garage

# --- Rate limiting (brute-force / credential-stuffing protection) ---
# Set to false to disable. Limit strings use slowapi syntax (e.g. 10/minute, 5/hour).
RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=10/minute
AUTH_REGISTER_RATE_LIMIT=10/hour
AUTH_REFRESH_RATE_LIMIT=30/minute

# --- CORS ---
CORS_ORIGINS=*
