# Copy to .env at the repo root and fill in real values before running the production
# docker-compose stack (docker-compose.yml + docker-compose.prod.yml). Never commit the real .env.

# Domain pointed at this server for the API, used by Traefik to route HTTPS traffic.
API_DOMAIN_NAME=api.fitfolio.example.com

# Domain pointed at this server for the web frontend, used by Traefik to route HTTPS traffic.
# Also used to build the API's CORS allow-list and the frontend's baked-in API base URL.
FRONTEND_DOMAIN_NAME=fitfolio.example.com

# Email used by Let's Encrypt for certificate expiry notices.
ACME_EMAIL=admin@example.com

# Docker Hub username that .github/workflows/api-ci.yml pushes images to
# (e.g. yourname/fitfolio:api) - must match the account, since docker-compose.prod.yml
# pulls this same image tag when the CI/CD workflow redeploys.
DOCKERHUB_USERNAME=your-dockerhub-username

# Optional overrides (defaults are already set in docker-compose.yml):
# POSTGRES_USER=fitfolio
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=fitfolio
# MINIO_ROOT_USER=fitfolio
# MINIO_ROOT_PASSWORD=change-me
