# Copy to .env at the repo root and fill in real values before running the production
# docker-compose stack (docker-compose.yml + docker-compose.prod.yml). Never commit the real .env.

# Domain pointed at this server, used by Traefik to route HTTPS traffic to the API.
DOMAIN_NAME=fitfolio.example.com

# Email used by Let's Encrypt for certificate expiry notices.
ACME_EMAIL=admin@example.com

# Optional overrides (defaults are already set in docker-compose.yml):
# POSTGRES_USER=fitfolio
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=fitfolio
# MINIO_ROOT_USER=fitfolio
# MINIO_ROOT_PASSWORD=change-me
